# Copy to .env before running Docker Compose and replace every placeholder for production.
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
SESSION_SECRET=replace-with-at-least-32-random-characters
CHANNEL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
MINIO_ACCESS_KEY=replace-with-a-minio-access-key
MINIO_SECRET_KEY=replace-with-a-strong-minio-secret-key
PUBLIC_BASE_PATH=
# Optional HTTP(S) proxy reachable from the worker container.
WORKER_PROXY_URL=
IMAGE_WORKER_CONCURRENCY=8
