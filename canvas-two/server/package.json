{
  "name": "infinite-canvas-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:prepare && node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/worker.ts",
    "dev:prepare": "prisma generate && prisma db push --skip-generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "minio": "^8.0.5",
    "msedge-tts": "^2.0.7",
    "multer": "^2.0.2",
    "prisma": "^6.13.0",
    "sharp": "^0.34.4",
    "undici": "^7.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.17.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
