generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(uuid())
  username            String
  usernameKey         String                @unique @map("username_key")
  passwordHash        String                @map("password_hash")
  role                String                @default("member")
  mustChangePassword  Boolean               @default(false) @map("must_change_password")
  deletedAt           DateTime?             @map("deleted_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  sessions            Session[]
  uploadedLocalVideos LocalVideoMaterial[]
  grantedPermissions  MemberPermission[]    @relation("PermissionGrantee")
  receivedPermissions MemberPermission[]    @relation("PermissionTarget")
  canvases            CanvasProject[]       @relation("CanvasOwner")
  createdCanvases     CanvasProject[]       @relation("CanvasCreator")
  updatedCanvases     CanvasProject[]       @relation("CanvasUpdater")
  canvasEditLeases    CanvasEditLease[]     @relation("CanvasLeaseHolder")
  generations         WorkbenchGeneration[] @relation("GenerationOwner")
  createdGenerations  WorkbenchGeneration[] @relation("GenerationCreator")
  updatedGenerations  WorkbenchGeneration[] @relation("GenerationUpdater")
  assets              Asset[]               @relation("AssetOwner")
  createdAssets       Asset[]               @relation("AssetCreator")
  updatedAssets       Asset[]               @relation("AssetUpdater")
  media               MediaFile[]           @relation("MediaOwner")
  createdMedia        MediaFile[]           @relation("MediaCreator")
  imageTasks          ImageGenerationTask[] @relation("ImageTaskOwner")
  createdImageTasks   ImageGenerationTask[] @relation("ImageTaskCreator")
  createdDetailPageVariants DetailPagePairVariant[] @relation("DetailPageVariantCreator")
  createdMainImageVariants MainImageReplicationVariant[] @relation("MainImageVariantCreator")
  detailPageTemplates  DetailPageTemplate[] @relation("DetailPageTemplateOwner")
  createdDetailPageTemplates DetailPageTemplate[] @relation("DetailPageTemplateCreator")
  updatedDetailPageTemplates DetailPageTemplate[] @relation("DetailPageTemplateUpdater")
  products            Product[]             @relation("ProductOwner")
  createdProducts     Product[]             @relation("ProductCreator")
  updatedProducts     Product[]             @relation("ProductUpdater")
  detailPageProjects  DetailPageProject[]   @relation("DetailPageOwner")
  createdDetailPages  DetailPageProject[]   @relation("DetailPageCreator")
  updatedDetailPages  DetailPageProject[]   @relation("DetailPageUpdater")
  mainImageReplicationProjects MainImageReplicationProject[] @relation("MainImageReplicationOwner")
  createdMainImageReplicationProjects MainImageReplicationProject[] @relation("MainImageReplicationCreator")
  updatedMainImageReplicationProjects MainImageReplicationProject[] @relation("MainImageReplicationUpdater")
  mainImageReplicationTemplates MainImageReplicationTemplate[] @relation("MainImageTemplateOwner")
  createdMainImageReplicationTemplates MainImageReplicationTemplate[] @relation("MainImageTemplateCreator")
  updatedMainImageReplicationTemplates MainImageReplicationTemplate[] @relation("MainImageTemplateUpdater")

  @@map("users")
}

model AutoVideoSetting {
  id String @id @default("default")
  channelId String @map("channel_id")
  model String
  visionChannelId String? @map("vision_channel_id")
  visionModel String? @map("vision_model")
    embedChannelId String? @map("embed_channel_id")
    embedModel String? @map("embed_model")
    storageDir String? @map("storage_dir")
    jianyingDir String? @map("jianying_dir")
    visionVerified String? @map("vision_verified")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("auto_video_settings")
}

model LocalVideoSku {
  id String @id @default(uuid())
  name String
  nameKey String @unique @map("name_key")
  materials LocalVideoMaterial[]
  @@map("local_video_skus")
}

model LocalVideoCategory {
  id String @id @default(uuid())
  name String
  nameKey String @unique @map("name_key")
  materials LocalVideoMaterial[]
  @@map("local_video_categories")
}

model LocalVideoMaterial {
  id String @id @default(uuid())
  skuId String? @map("sku_id")
  categoryId String? @map("category_id")
  fileName String @map("file_name")
  fileKey String @unique @map("file_key")
  bytes Int
  notes String?
  duration Float?
  width Int?
  height Int?
  fps Float?
  thumbnail String?
  disabled Boolean @default(false)
  annotation Json?
  proposedAnnotation Json? @map("proposed_annotation")
  annotationSource String? @map("annotation_source")
  revision Int @default(0)
  analysisStatus String @default("pending") @map("analysis_status")
  analysisError String? @map("analysis_error")
  embedding Unsupported("vector")?
  embeddingKey String? @map("embedding_key")
  embeddingDimension Int? @map("embedding_dimension")
  indexedRevision Int? @map("indexed_revision")
  uploadedById String @map("uploaded_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  sku LocalVideoSku? @relation(fields: [skuId], references: [id], onDelete: Restrict)
  category LocalVideoCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  @@index([skuId, categoryId, deletedAt, createdAt], map: "local_video_materials_selection_idx")
  @@map("local_video_materials")
}

model AutoVideoPlan {
  id String @id @default(uuid())
  createdById String @map("created_by_id")
  requestId String @unique @map("request_id")
  revision Int @default(1)
  status String @default("queued")
  input Json
  document Json?
  error String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("auto_video_plans")
}

model AutoVideoJob {
  id String @id @default(uuid())
  kind String
  targetId String @map("target_id")
  dedupeKey String @unique @map("dedupe_key")
  status String @default("queued")
  payload Json
  result Json?
  attempts Int @default(0)
  leaseToken String? @map("lease_token")
  leaseUntil DateTime? @map("lease_until")
  availableAt DateTime @default(now()) @map("available_at")
  error String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([kind, status, availableAt])
  @@index([targetId, createdAt])
  @@map("auto_video_jobs")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model MemberPermission {
  id        String   @id @default(uuid())
  granteeId String   @map("grantee_id")
  targetId  String   @map("target_id")
  level     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  grantee   User     @relation("PermissionGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  target    User     @relation("PermissionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([granteeId, targetId])
  @@map("member_permissions")
}

model CanvasProject {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  createdById String   @map("created_by_id")
  updatedById String   @map("updated_by_id")
  title       String
  payload     Json
  revision    Int      @default(1)
  legacyId    String?  @map("legacy_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User     @relation("CanvasOwner", fields: [ownerId], references: [id])
  createdBy   User     @relation("CanvasCreator", fields: [createdById], references: [id])
  updatedBy   User     @relation("CanvasUpdater", fields: [updatedById], references: [id])
  editLease   CanvasEditLease?

  @@unique([ownerId, legacyId])
  @@index([ownerId, updatedAt])
  @@map("canvas_projects")
}

model CanvasEditLease {
  id          String        @id @default(uuid())
  canvasId    String        @unique @map("canvas_id")
  holderId    String        @map("holder_id")
  clientId    String        @map("client_id")
  acquiredAt  DateTime      @default(now()) @map("acquired_at")
  heartbeatAt DateTime      @default(now()) @map("heartbeat_at")
  expiresAt   DateTime      @map("expires_at")
  canvas      CanvasProject @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  holder      User          @relation("CanvasLeaseHolder", fields: [holderId], references: [id], onDelete: Cascade)

  @@index([holderId])
  @@index([expiresAt])
  @@map("canvas_edit_leases")
}

model WorkbenchGeneration {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  createdById String   @map("created_by_id")
  updatedById String   @map("updated_by_id")
  kind        String
  title       String
  status      String   @default("success")
  payload     Json
  revision    Int      @default(1)
  legacyId    String?  @map("legacy_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User     @relation("GenerationOwner", fields: [ownerId], references: [id])
  createdBy   User     @relation("GenerationCreator", fields: [createdById], references: [id])
  updatedBy   User     @relation("GenerationUpdater", fields: [updatedById], references: [id])

  @@unique([ownerId, kind, legacyId])
  @@index([ownerId, kind, createdAt])
  @@map("workbench_generations")
}

model Asset {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  createdById String   @map("created_by_id")
  updatedById String   @map("updated_by_id")
  kind        String
  title       String
  payload     Json
  revision    Int      @default(1)
  legacyId    String?  @map("legacy_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User     @relation("AssetOwner", fields: [ownerId], references: [id])
  createdBy   User     @relation("AssetCreator", fields: [createdById], references: [id])
  updatedBy   User     @relation("AssetUpdater", fields: [updatedById], references: [id])

  @@unique([ownerId, legacyId])
  @@index([ownerId, updatedAt])
  @@map("assets")
}

model MediaFile {
  id                  String   @id @default(uuid())
  ownerId             String   @map("owner_id")
  createdById         String   @map("created_by_id")
  visibility          String   @default("private") // private=仅授权成员可见 / public=登录成员可见（如知识库贴图）
  origin              String   @default("upload") // upload=通用上传 / kb=知识库贴图（帖子删除时可安全清理）
  objectKey           String   @unique @map("object_key")
  fileName            String   @map("file_name")
  mimeType            String   @map("mime_type")
  bytes               BigInt
  thumbnailObjectKey  String?  @unique @map("thumbnail_object_key")
  thumbnailMimeType   String?  @map("thumbnail_mime_type")
  thumbnailBytes      BigInt?  @map("thumbnail_bytes")
  legacyStorageKey    String?  @map("legacy_storage_key")
  createdAt           DateTime @default(now()) @map("created_at")
  owner               User     @relation("MediaOwner", fields: [ownerId], references: [id])
  createdBy           User     @relation("MediaCreator", fields: [createdById], references: [id])
  products            ProductMedia[]
  detailPageProductProjects DetailPageProject[] @relation("DetailPageProductMedia")
  detailPagePairReferences DetailPagePair[] @relation("DetailPagePairReference")
  detailPagePairResults    DetailPagePair[] @relation("DetailPagePairResult")
  detailPagePairVariantMedia   DetailPagePairVariant[] @relation("DetailPagePairVariantMedia")
  detailPagePairVariantSources DetailPagePairVariant[] @relation("DetailPagePairVariantSource")
  detailPagePairReferencesExtra DetailPagePairReference[]
  detailPageTemplateReferences DetailPageTemplateReference[]
  mainImageReplicationProductProjects MainImageReplicationProject[] @relation("MainImageProductMedia")
  mainImageReplicationPairReferences MainImageReplicationPair[] @relation("MainImagePairReference")
  mainImageReplicationPairResults MainImageReplicationPair[] @relation("MainImagePairResult")
  mainImageReplicationVariantMedia MainImageReplicationVariant[] @relation("MainImageVariantMedia")
  mainImageReplicationVariantSources MainImageReplicationVariant[] @relation("MainImageVariantSource")
  mainImageReplicationTemplateReferences MainImageReplicationTemplateReference[]

  @@unique([ownerId, legacyStorageKey])
  @@index([ownerId, createdAt])
  @@map("media_files")
}

model ModelChannel {
  id              String         @id @default(uuid())
  name            String
  baseUrl         String         @map("base_url")
  apiFormat       String         @map("api_format")
  apiKeyEncrypted String         @map("api_key_encrypted")
  enabled         Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  models          ChannelModel[]
  imageTasks      ImageGenerationTask[]

  @@map("model_channels")
}

model ChannelModel {
  id         String       @id @default(uuid())
  channelId  String       @map("channel_id")
  name       String
  capability String
  enabled    Boolean      @default(true)
  channel    ModelChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, name])
  @@map("channel_models")
}

model ImageGenerationTask {
  id                String    @id @default(uuid())
  ownerId           String    @map("owner_id")
  createdById       String    @map("created_by_id")
  channelId         String    @map("channel_id")
  clientRequestId   String    @map("client_request_id")
  retryOfId         String?   @map("retry_of_id")
  operation         String
  model             String
  prompt            String
  requestPrompt     String    @map("request_prompt")
  parameters        Json
  references        Json
  maskMediaId       String?   @map("mask_media_id")
  context           Json?
  status            String    @default("queued")
  completedCount    Int       @default(0) @map("completed_count")
  totalCount        Int       @default(1) @map("total_count")
  results           Json
  error             String?
  attempt           Int       @default(0)
  startedAt         DateTime? @map("started_at")
  heartbeatAt       DateTime? @map("heartbeat_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  owner              User      @relation("ImageTaskOwner", fields: [ownerId], references: [id])
  createdBy          User      @relation("ImageTaskCreator", fields: [createdById], references: [id])
  channel            ModelChannel @relation(fields: [channelId], references: [id])
  activeProduct       Product?  @relation("ProductActiveTask")
  detailPagePair      DetailPagePair? @relation("DetailPagePairTask")
  detailPagePairVariant DetailPagePairVariant? @relation("DetailPagePairVariantTask")
  mainImageReplicationPair MainImageReplicationPair? @relation("MainImagePairTask")
  mainImageReplicationVariant MainImageReplicationVariant? @relation("MainImageVariantTask")

  @@unique([ownerId, clientRequestId])
  @@index([status, createdAt])
  @@index([ownerId, createdAt])
  @@map("image_generation_tasks")
}

model Product {
  id           String               @id @default(uuid())
  ownerId      String               @map("owner_id")
  createdById  String               @map("created_by_id")
  updatedById  String               @map("updated_by_id")
  name         String
  brand        String               @default("")
  productType  String               @default("") @map("product_type")
  sellingPoints String[]            @default([]) @map("selling_points")
  material     String               @default("")
  instruction  String               @default("")
  status       String               @default("draft")
  error        String?
  activeTaskId String?              @unique @map("active_task_id")
  revision     Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  owner        User                 @relation("ProductOwner", fields: [ownerId], references: [id])
  createdBy    User                 @relation("ProductCreator", fields: [createdById], references: [id])
  updatedBy    User                 @relation("ProductUpdater", fields: [updatedById], references: [id])
  activeTask   ImageGenerationTask? @relation("ProductActiveTask", fields: [activeTaskId], references: [id], onDelete: SetNull)
  media        ProductMedia[]
  detailPages  DetailPageProject[]
  mainImageReplicationProjects MainImageReplicationProject[] @relation("MainImageProductProjects")

  @@index([ownerId, updatedAt])
  @@index([ownerId, name])
  @@map("products")
}

model DetailPageProject {
  id            String           @id @default(uuid())
  ownerId       String           @map("owner_id")
  productId     String           @map("product_id")
  productMediaId String          @map("product_media_id")
  createdById   String           @map("created_by_id")
  updatedById   String           @map("updated_by_id")
  title         String
  status        String           @default("draft")
  error         String?
  revision      Int              @default(1)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  owner         User             @relation("DetailPageOwner", fields: [ownerId], references: [id])
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  productMedia  MediaFile        @relation("DetailPageProductMedia", fields: [productMediaId], references: [id])
  createdBy     User             @relation("DetailPageCreator", fields: [createdById], references: [id])
  updatedBy     User             @relation("DetailPageUpdater", fields: [updatedById], references: [id])
  pairs         DetailPagePair[]

  @@index([ownerId, updatedAt])
  @@index([productId])
  @@map("detail_page_projects")
}

model DetailPageTemplate {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  createdById String   @map("created_by_id")
  updatedById String   @map("updated_by_id")
  name        String
  revision    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User     @relation("DetailPageTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("DetailPageTemplateCreator", fields: [createdById], references: [id])
  updatedBy   User     @relation("DetailPageTemplateUpdater", fields: [updatedById], references: [id])
  references  DetailPageTemplateReference[]

  @@unique([ownerId, name])
  @@index([ownerId, updatedAt])
  @@map("detail_page_templates")
}

model DetailPageTemplateReference {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  mediaId    String   @map("media_id")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  template   DetailPageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  media      MediaFile @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([templateId, mediaId])
  @@unique([templateId, sortOrder])
  @@index([mediaId])
  @@map("detail_page_template_references")
}

model DetailPagePair {
  id              String              @id @default(uuid())
  projectId       String              @map("project_id")
  sortOrder       Int                 @default(0) @map("sort_order")
  referenceMediaId String             @map("reference_media_id")
  resultMediaId   String?             @map("result_media_id")
  referenceWidth  Int                 @map("reference_width")
  referenceHeight Int                 @map("reference_height")
  prompt          String              @default("")
  resolvedPrompt  String?             @map("resolved_prompt")
  generationModel String?             @map("generation_model")
  generationChannelId String?         @map("generation_channel_id")
  generationResolution String         @default("1k") @map("generation_resolution")
  generationAspectRatio String        @default("original") @map("generation_aspect_ratio")
  generationQuality String             @default("auto") @map("generation_quality")
  activeTaskId    String?             @unique @map("active_task_id")
  status          String              @default("draft")
  error           String?
  revision        Int                 @default(1)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  project         DetailPageProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referenceMedia  MediaFile           @relation("DetailPagePairReference", fields: [referenceMediaId], references: [id])
  resultMedia     MediaFile?          @relation("DetailPagePairResult", fields: [resultMediaId], references: [id])
  activeTask      ImageGenerationTask? @relation("DetailPagePairTask", fields: [activeTaskId], references: [id], onDelete: SetNull)
  variants        DetailPagePairVariant[]
  references     DetailPagePairReference[]

  @@unique([projectId, referenceMediaId])
  @@index([projectId, sortOrder])
  @@map("detail_page_pairs")
}

model DetailPagePairReference {
  id         String   @id @default(uuid())
  pairId     String   @map("pair_id")
  mediaId    String   @map("media_id")
  kind       String   @default("upload")
  selected   Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  pair       DetailPagePair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  media      MediaFile @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([pairId, mediaId])
  @@index([pairId, sortOrder])
  @@index([mediaId])
  @@map("detail_page_pair_references")
}

model DetailPagePairVariant {
  id             String   @id @default(uuid())
  pairId         String   @map("pair_id")
  mediaId        String?  @map("media_id")
  sourceMediaId  String?  @map("source_media_id")
  kind           String
  status         String   @default("draft")
  prompt         String   @default("")
  resolvedPrompt String?  @map("resolved_prompt")
  activeTaskId   String?  @unique @map("active_task_id")
  error          String?
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  revision       Int      @default(1)
  pair           DetailPagePair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  media          MediaFile? @relation("DetailPagePairVariantMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  sourceMedia    MediaFile? @relation("DetailPagePairVariantSource", fields: [sourceMediaId], references: [id], onDelete: SetNull)
  activeTask     ImageGenerationTask? @relation("DetailPagePairVariantTask", fields: [activeTaskId], references: [id], onDelete: SetNull)
  createdBy      User @relation("DetailPageVariantCreator", fields: [createdById], references: [id])

  @@index([pairId, createdAt])
  @@index([mediaId])
  @@map("detail_page_pair_variants")
}

model MainImageReplicationProject {
  id            String   @id @default(uuid())
  ownerId       String   @map("owner_id")
  productId     String   @map("product_id")
  productMediaId String  @map("product_media_id")
  createdById   String   @map("created_by_id")
  updatedById   String   @map("updated_by_id")
  title         String
  status        String   @default("draft")
  error         String?
  revision      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  owner         User     @relation("MainImageReplicationOwner", fields: [ownerId], references: [id])
  product       Product  @relation("MainImageProductProjects", fields: [productId], references: [id], onDelete: Restrict)
  productMedia  MediaFile @relation("MainImageProductMedia", fields: [productMediaId], references: [id])
  createdBy     User     @relation("MainImageReplicationCreator", fields: [createdById], references: [id])
  updatedBy     User     @relation("MainImageReplicationUpdater", fields: [updatedById], references: [id])
  pairs         MainImageReplicationPair[]
  @@index([ownerId, updatedAt])
  @@index([productId])
  @@map("main_image_replication_projects")
}

model MainImageReplicationPair {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  sortOrder       Int      @default(0) @map("sort_order")
  referenceMediaId String  @map("reference_media_id")
  resultMediaId   String?  @map("result_media_id")
  referenceWidth  Int      @map("reference_width")
  referenceHeight Int      @map("reference_height")
  prompt          String   @default("")
  resolvedPrompt  String?  @map("resolved_prompt")
  activeTaskId    String?  @unique @map("active_task_id")
  status          String   @default("draft")
  error           String?
  revision        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  project         MainImageReplicationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referenceMedia  MediaFile @relation("MainImagePairReference", fields: [referenceMediaId], references: [id])
  resultMedia     MediaFile? @relation("MainImagePairResult", fields: [resultMediaId], references: [id])
  activeTask      ImageGenerationTask? @relation("MainImagePairTask", fields: [activeTaskId], references: [id], onDelete: SetNull)
  variants        MainImageReplicationVariant[]
  @@unique([projectId, referenceMediaId])
  @@index([projectId, sortOrder])
  @@map("main_image_replication_pairs")
}

model MainImageReplicationVariant {
  id             String   @id @default(uuid())
  pairId         String   @map("pair_id")
  mediaId        String?  @map("media_id")
  sourceMediaId  String?  @map("source_media_id")
  kind           String
  status         String   @default("draft")
  prompt         String   @default("")
  resolvedPrompt String?  @map("resolved_prompt")
  activeTaskId   String?  @unique @map("active_task_id")
  error          String?
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  revision       Int      @default(1)
  pair           MainImageReplicationPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  media          MediaFile? @relation("MainImageVariantMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  sourceMedia    MediaFile? @relation("MainImageVariantSource", fields: [sourceMediaId], references: [id], onDelete: SetNull)
  activeTask     ImageGenerationTask? @relation("MainImageVariantTask", fields: [activeTaskId], references: [id], onDelete: SetNull)
  createdBy      User @relation("MainImageVariantCreator", fields: [createdById], references: [id])
  @@index([pairId, createdAt])
  @@map("main_image_replication_variants")
}

model MainImageReplicationTemplate {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  createdById String   @map("created_by_id")
  updatedById String   @map("updated_by_id")
  name        String
  revision    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User @relation("MainImageTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy   User @relation("MainImageTemplateCreator", fields: [createdById], references: [id])
  updatedBy   User @relation("MainImageTemplateUpdater", fields: [updatedById], references: [id])
  references  MainImageReplicationTemplateReference[]
  @@unique([ownerId, name])
  @@index([ownerId, updatedAt])
  @@map("main_image_replication_templates")
}

model MainImageReplicationTemplateReference {
  id         String @id @default(uuid())
  templateId String @map("template_id")
  mediaId    String @map("media_id")
  sortOrder  Int @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  template MainImageReplicationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  media MediaFile @relation(fields: [mediaId], references: [id])
  @@unique([templateId, mediaId])
  @@unique([templateId, sortOrder])
  @@map("main_image_replication_template_references")
}

model ProductMedia {
  id        String    @id @default(uuid())
  productId String    @map("product_id")
  mediaId   String    @map("media_id")
  role      String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaFile @relation(fields: [mediaId], references: [id])

  @@unique([productId, mediaId, role])
  @@index([productId, role, sortOrder])
  @@index([mediaId])
  @@map("product_media")
}

// ===== 公司知识库模块（表互相内聚，不与其他模块外键耦合） =====

model KbCategory {
  id        String    @id @default(uuid())
  name      String
  sort      Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  posts     KbPost[]

  @@map("kb_categories")
}

model KbPost {
  id          String    @id @default(uuid())
  authorId    String    @map("author_id")
  categoryId  String?   @map("category_id")
  title       String
  type        String    @default("insight") // insight=心得 / workflow=流程 / qa=问答
  content     String
  tags        String[]  @default([])
  status      String    @default("published") // draft / published / archived
  official    Boolean   @default(false) // 管理员标记的官方流程，检索加权
  viewCount   Int       @default(0) @map("view_count")
  indexStatus String    @default("pending") @map("index_status") // pending / indexed / failed
  indexError  String?   @map("index_error")
  indexedAt   DateTime? @map("indexed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  category    KbCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments    KbComment[]
  chunks      KbChunk[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status, updatedAt])
  @@map("kb_posts")
}

model KbComment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  content   String
  parentId  String?  @map("parent_id") // 楼中楼
  createdAt DateTime @default(now()) @map("created_at")
  post      KbPost   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("kb_comments")
}

model KbChunk {
  id        String                   @id @default(uuid())
  postId    String                   @map("post_id")
  ord       Int // 片段序号
  heading   String? // 所属小节标题，提升检索命中率
  content   String
  embedding Unsupported("vector")? // pgvector，维度由所选 embedding 模型决定
  updatedAt DateTime                 @updatedAt @map("updated_at")
  post      KbPost                   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("kb_chunks")
}

model KbConversation {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  title     String
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  messages  KbMessage[]

  @@index([userId, updatedAt])
  @@map("kb_conversations")
}

model KbMessage {
  id           String         @id @default(uuid())
  convId       String         @map("conv_id")
  role         String // user / assistant
  content      String
  citations    Json? // [{postId, chunkId, title, excerpt}]
  feedback     Int? // 1 有用 / -1 无用
  createdAt    DateTime       @default(now()) @map("created_at")
  conversation KbConversation @relation(fields: [convId], references: [id], onDelete: Cascade)

  @@index([convId])
  @@map("kb_messages")
}

model KbSetting {
  id                String   @id @default("default")
  chatChannelId     String?  @map("chat_channel_id")
  chatModel         String?  @map("chat_model")
  embedChannelId    String?  @map("embed_channel_id")
  embedModel        String?  @map("embed_model")
  dailyLimitPerUser Int      @default(50) @map("daily_limit_per_user") // 每用户每日提问上限，0 为不限
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("kb_settings")
}

